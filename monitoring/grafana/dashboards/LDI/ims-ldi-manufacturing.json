    {
      "datasource": {
        "uid": "LDI"
      },
      "description": "Estimated Yield: percentage of samples where max|PE| <= pe_setting (within tolerance).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#EF4444",
                "value": null
              },
              {
                "color": "#FACC15",
                "value": 90
              },
              {
                "color": "#22C55E",
                "value": 95
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 15,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "noValue": "-",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "titleSize": 14,
          "valueSize": 48
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "LDI"
          },
          "format": "table",
          "rawSql": "\nSELECT\n   ROUND((COUNT(*) FILTER (\nWHERE\n   GREATEST(ABS(pe_1), ABS(pe_2), ABS(pe_3), ABS(pe_4), ABS(pe_5), ABS(pe_6)) <= pe_setting)::NUMERIC / NULLIF(COUNT(*) FILTER (\nWHERE\n   pe_1 IS NOT NULL), 0)) * 100, 1) AS value \nFROM\n   public.ldi_data \nWHERE\n   $__timeFilter(time) \n  AND  factory IN ($Factory) \n  AND  process IN ($process)",
          "refId": "A"
        }
      ],
      "title": "Estimated Yield (%)",
      "transparent": true,
      "type": "stat"
    },
