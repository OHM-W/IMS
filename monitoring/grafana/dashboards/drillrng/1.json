      "panel-18": {
        "kind": "Panel",
        "spec": {
          "id": 18,
          "title": "Event Rate Deviation (15m Z-Score)",
          "description": "Statistical anomaly detection flagging significant spikes or dropouts in event transmission frequency",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "spec": {
                        "format": "table",
                        "rawSql": "WITH bins AS (\n  SELECT equipment_id, date_bin(INTERVAL '15 minutes', event_time, TIMESTAMPTZ '1970-01-01') AS bucket, COUNT(*) AS event_count\n  FROM public.machine_event\n  WHERE $__timeFilter(event_time)\n    AND ('All' IN (${machine_id:singlequote}) OR equipment_id IN (${machine_id:singlequote}))\n  GROUP BY equipment_id,bucket\n), stats AS (\n  SELECT equipment_id,AVG(event_count) AS mean_count,STDDEV_POP(event_count) AS sd_count\n  FROM bins GROUP BY equipment_id\n), scored AS (\n  SELECT b.equipment_id,b.bucket,b.event_count,s.mean_count,s.sd_count,\n    CASE WHEN s.sd_count>0 THEN (b.event_count-s.mean_count)/s.sd_count END AS z_score\n  FROM bins b JOIN stats s USING (equipment_id)\n)\nSELECT equipment_id AS \"Machine ID\",bucket AS \"Bucket\",event_count AS \"Events\",ROUND(mean_count::NUMERIC,1) AS \"Mean\",ROUND(sd_count::NUMERIC,1) AS \"Std Dev\",ROUND(z_score::NUMERIC,2) AS \"Z Score\"\nFROM scored WHERE ABS(z_score)>=2\nORDER BY ABS(z_score) DESC,bucket DESC\nLIMIT 200"
                      },
                      "labels": {
                        "grafana.app/export-label": "postgres-1",
                        "grafana.app/export-datasource-name": "grafana-postgresql-datasource"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
