          "format": "table",
          "rawSql": "WITH target AS (  SELECT \"time\" FROM public.ldi_data   WHERE eqp_id IN (${Eqp:singlequote}) AND ( (NULLIF('${exact_time}', '') IS NOT NULL AND \"time\" >= to_timestamp(NULLIF('${exact_time}', '')::numeric / 1000.0) - interval '10 milliseconds' AND \"time\" < to_timestamp(NULLIF('${exact_time}', '')::numeric / 1000.0) + interval '1 second') OR (NULLIF('${exact_time}', '') IS NULL AND \"time\" >= to_timestamp(NULLIF('${clicked_time}', '')::numeric / 1000.0) AND \"time\" < to_timestamp(NULLIF('${clicked_time}', '')::numeric / 1000.0) + interval '1 minute') )) SELECT al.logdate AS \"Time\", al.eqp_id AS \"Machine\", al.errorcode AS \"errorcode\", al.logdate AS \"errortime\", COALESCE(m.alarm_msg, al.errorcode::TEXT) AS \"Message\", COALESCE(m.alarm_type, 'WARN') AS \"Severity\", COALESCE(m.alarm_detail, '') AS \"Details\" FROM public.ldi_alarm_log al LEFT JOIN public.ldi_alarm_ms_code m ON al.errorcode::TEXT = m.alarm_code::TEXT WHERE al.eqp_id IN (${Eqp:singlequote}) AND al.logdate >= (SELECT MIN(\"time\") - INTERVAL '5 minutes' FROM target) AND al.logdate <= (SELECT MAX(\"time\") + INTERVAL '5 minutes' FROM target) ORDER BY al.logdate DESC",
