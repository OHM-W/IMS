# =====================================================================
# IMS Floorplan-Web Standalone Configuration
# =====================================================================

# Host Web Port
PORT=8085

# Primary Telemetry Database (TimescaleDB / PostgreSQL)
# ใช้ 'host.docker.internal' หาก Database รันอยู่บน Host OS เครื่องเดียวกัน
# หรือใส่ IP ตรงๆ เช่น 192.168.1.100 หาก Database อยู่คนละเครื่อง
PGHOST=host.docker.internal
PGPORT=5432
PGDATABASE=ims
PGUSER=postgres
PGPASSWORD=postgres

# CNC Drilling Database (หากเปิดใช้งาน multi-db ใน backend/data/databases.json)
DRILL_DB_PASSWORD=

# Telemetry Broadcast Frequency (ms)
BROADCAST_INTERVAL_MS=2000
STALENESS_THRESHOLD_MINUTES=15
