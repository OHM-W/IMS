{
  "drill_db": {
    "type": "postgres",
    "host": "127.0.0.1",
    "port": 5433,
    "database": "mydb",
    "user": "postgres",
    "password_env": "DRILL_DB_PASSWORD",
    "process_type": "DRILLING",
    "enabled": true
  },
  "chem_db": {
    "type": "postgres",
    "host": "192.168.1.60",
    "port": 5432,
    "database": "oxide_db",
    "user": "postgres",
    "password_env": "CHEM_DB_PASSWORD",
    "process_type": "OXIDE",
    "enabled": false,
    "query": "SELECT line_id AS eqp_id, state AS status, bath_temp, ph_level, flow_rate, updated_at AS last_seen FROM public.oxide_line"
  },
  "cut_db": {
    "type": "postgres",
    "host": "192.168.1.70",
    "port": 5432,
    "database": "cutting_db",
    "user": "postgres",
    "password_env": "CUT_DB_PASSWORD",
    "process_type": "CUTTING",
    "enabled": false
  }
}
