      "panel-203": {
        "kind": "Panel",
        "spec": {
          "id": 203,
          "title": "Ingestion & Pipeline Health",
          "description": "Source traceability, file origins, ingestion timestamps, and pipeline latency (ms) per machine",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "spec": {
                        "format": "table",
                        "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: latest ingestion and decoder metadata for every machine. */\nSELECT DISTINCT ON (equipment_id) equipment_id AS \"Machine ID\",source AS \"Source\",source_file AS \"Source File\",event_time AS \"Latest Event\",sent_time AS \"Sent\",received_at AS \"Received\",\n  ROUND((1000.0*EXTRACT(EPOCH FROM (received_at-sent_time)))::NUMERIC,1) AS \"Ingestion ms\",decode_status AS \"Decode Status\",decoder_version AS \"Decoder Version\",'LATEST_KNOWN' AS \"State Policy\"\nFROM public.machine_event ORDER BY equipment_id,event_time DESC,id DESC LIMIT 100"
                      },
                      "labels": {
                        "grafana.app/export-label": "postgres-1",
                        "grafana.app/export-datasource-name": "grafana-postgresql-datasource"
