          "rawSql": "SELECT \r\nROUND(pe_1::NUMERIC, 3) AS \"pe_1\", \r\nROUND(pe_2::NUMERIC, 3) AS \"pe_2\", \r\nROUND(pe_3::NUMERIC, 3) AS \"pe_3\", \r\nROUND(pe_4::NUMERIC, 3) AS \"pe_4\", \r\nROUND(pe_5::NUMERIC, 3) AS \"pe_5\", \r\nROUND(pe_6::NUMERIC, 3) AS \"pe_6\", \r\nROUND(GREATEST(ABS(COALESCE(pe_1,0)), \r\nABS(COALESCE(pe_2,0)), \r\nABS(COALESCE(pe_3,0)), \r\nABS(COALESCE(pe_4,0)), \r\nABS(COALESCE(pe_5,0)), \r\nABS(COALESCE(pe_6,0)))::NUMERIC, 3) AS \"MAX|PE|\", \r\nROUND(pe_setting::NUMERIC, 1) AS \"pe_setting\" \r\nFROM public.ldi_data \r\nWHERE eqp_id IN (${Eqp:singlequote}) \r\nAND ( (NULLIF('${exact_time}', '') IS NOT NULL \r\nAND \"time\" >= to_timestamp(NULLIF('${exact_time}', '')::numeric / 1000.0) - interval '10 milliseconds' \r\nAND \"time\" < to_timestamp(NULLIF('${exact_time}', '')::numeric / 1000.0) + interval '1 second') OR (NULLIF('${exact_time}', '') IS NULL \r\nAND \"time\" >= to_timestamp(NULLIF('${clicked_time}', '')::numeric / 1000.0) \r\nAND \"time\" < to_timestamp(NULLIF('${clicked_time}', '')::numeric / 1000.0) + interval '1 minute') )\r\nLIMIT 1;",
          "refId": "A",
