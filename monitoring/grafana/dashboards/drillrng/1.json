      "panel-14": {
        "kind": "Panel",
        "spec": {
          "id": 14,
          "title": "Detected Anomalies (Rule-Based)",
          "description": "Rule-based anomaly detection covering extended stop durations, telemetry dropouts, alarm bursts, and tool life limits",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "spec": {
                        "format": "table",
                        "rawSql": "WITH latest_status AS (\n  SELECT DISTINCT ON (equipment_id) equipment_id,event_time,event_type,event_message\n  FROM public.machine_event WHERE message_type='status' ORDER BY equipment_id,event_time DESC,id DESC\n), status_points AS (\n  SELECT equipment_id,event_time,event_type,event_message,LEAD(event_time) OVER (PARTITION BY equipment_id ORDER BY event_time,id) AS next_time\n  FROM public.machine_event WHERE message_type='status' AND $__timeFilter(event_time)\n), alarm_bursts AS (\n  SELECT equipment_id,date_bin(INTERVAL '5 minutes',event_time,TIMESTAMPTZ '1970-01-01') AS bucket,COUNT(*) AS errors,MIN(event_code) AS example_code\n  FROM public.machine_event WHERE message_type='alarm' AND level='E' AND $__timeFilter(event_time)\n  GROUP BY equipment_id,bucket HAVING COUNT(*)>=${alarm_burst:raw}\n), anomalies AS (\n  SELECT 'CRITICAL'::TEXT AS severity,'Telemetry age exceeds setting'::TEXT AS anomaly,equipment_id,event_time AS detected_at,\n    'Latest state='||event_type||'; age='||ROUND(EXTRACT(EPOCH FROM (NOW()-event_time))/3600)::TEXT||'h' AS evidence,'>'||${stale_hours:raw}||' hours' AS threshold\n  FROM latest_status WHERE NOW()-event_time>(${stale_hours:raw}||' hours')::INTERVAL\n  UNION ALL SELECT 'HIGH','Long observed STOP',equipment_id,event_time,\n    'STOP duration='||ROUND(EXTRACT(EPOCH FROM (next_time-event_time))/60)::TEXT||'m; '||COALESCE(event_message,''),'>'||${stop_minutes:raw}||' minutes'\n  FROM status_points WHERE event_type='STOP' AND next_time IS NOT NULL AND next_time-event_time>(${stop_minutes:raw}||' minutes')::INTERVAL\n  UNION ALL SELECT 'HIGH','Historical error burst',equipment_id,bucket,errors::TEXT||' level-E records in 5m; example='||COALESCE(example_code,''),'>='||${alarm_burst:raw}||' records / 5m' FROM alarm_bursts\n  UNION ALL SELECT 'MEDIUM','Tool reached reported life',equipment_id,event_time,COALESCE(event_code,'')||' '||COALESCE(event_message,''),'event_code=0119'\n    FROM public.machine_event WHERE event_code='0119' AND $__timeFilter(event_time)\n  UNION ALL SELECT 'MEDIUM','Decoder reported a problem',equipment_id,event_time,COALESCE(decode_status,'NULL')||': '||COALESCE(decode_error,''),'decode_status not successful'\n    FROM public.machine_event WHERE $__timeFilter(event_time) AND (decode_error IS NOT NULL OR COALESCE(UPPER(decode_status),'') NOT IN ('SUCCESS','DECODED','OK','DECODED_MSGMANAGE'))\n)\nSELECT severity AS \"Severity\",anomaly AS \"What\",equipment_id AS \"Machine\",detected_at AS \"When\",evidence AS \"Evidence\",threshold AS \"Rule\"\nFROM anomalies\nWHERE ('All' IN (${machine_id:sqlstring}) OR equipment_id IN (${machine_id:sqlstring}))\nORDER BY detected_at DESC,severity LIMIT 200"
                      },
                      "labels": {
                        "grafana.app/export-label": "postgres-1",
                        "grafana.app/export-datasource-name": "grafana-postgresql-datasource"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
