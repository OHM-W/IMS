      },
      "targets": [
        {
          "datasource": {
            "uid": "LDI"
          },
          "format": "table",
          "rawSql": "\nSELECT\n   COUNT(*)::NUMERIC AS value \nFROM\n   public.ldi_alarm_log a \nLEFT JOIN\n   public.ldi_alarm_ms_code m ON a.errorcode::TEXT = m.alarm_code::TEXT \nWHERE\n   a.logdate >= NOW() - INTERVAL '5 minutes' \n  AND  m.alarm_type ILIKE '%Critical%'",
          "refId": "A"
        }
      ],
      "title": "Active Critical Alarms",
      "transparent": true,
      "type": "stat"
    },
    {
      "datasource": {
        "uid": "LDI"
      },
      "description": "Latest production context per machine: job info + live physical parameters (temperature, humidity, scan_speed, thickness, resist_dosage, state).",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Machine"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "keepTime": true,
                    "targetBlank": true,
                    "title": "Analyze Process Trend",
                    "url": "/d/ldi-engineering-analytics/ims-ldi-engineering-analytics?var-machine_id=${__data.fields.Machine}&from=${__from}&to=${__to}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Timestamp"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "decimals",
                "value": 6
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "decimals",
                "value": 6
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 6,
      "options": {
        "rowHeight": 0.6,
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Machine"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "uid": "LDI"
          },
          "format": "table",
          "rawSql": "\nSELECT\n   DISTINCT ON (eqp_id) eqp_id AS \"Machine\", mo AS \"Job (MO)\", fpn AS \"Part (FPN)\", layer_name AS \"Layer\", (board_no::TEXT || '/' || total_board::TEXT) AS \"Progress\", ROUND(temperature::NUMERIC, 1) AS \"temperature (°C)\", ROUND(humidity::NUMERIC, 1) AS \"humidity (%RH)\", ROUND(scan_speed::NUMERIC, 1) AS \"scan_speed (mm/s)\", ROUND(thickness::NUMERIC, 3) AS \"thickness (mm)\", ROUND(resist_dosage::NUMERIC, 1) AS \"resist_dosage\", state AS \"state\" \nFROM\n   public.ldi_data \nWHERE\n   factory IN ($Factory) \n  AND  process IN ($process) \n  AND  $__timeFilter(time) \nORDER BY\n   eqp_id, time DESC \nLIMIT\n   50",
          "refId": "A"
        }
      ],
      "title": "Production & Process Table",
      "transparent": true,
      "type": "table"
    },
