      "targets": [
        {
          "datasource": {
            "uid": "LDI"
          },
          "format": "time_series",
          "legendFormat": "{{metric}}",
          "rawSql": "WITH stats AS (\nSELECT\n   eqp_id, AVG(temperature) AS mu, STDDEV(temperature) AS sigma \nFROM\n   public.ldi_data \nWHERE\n   time > NOW() - INTERVAL '24 hours' \nGROUP BY\n   eqp_id) \nSELECT\n   d.time, d.eqp_id AS metric, ROUND(((d.temperature - s.mu) / NULLIF(s.sigma, 0))::NUMERIC, 2) AS \"Z-Score\" \nFROM\n   public.ldi_data d JOIN stats s ON d.eqp_id = s.eqp_id \nWHERE\n   factory IN ($Factory) \n  AND  process IN ($process) \n  AND  $__timeFilter(time) \n  AND  d.temperature IS NOT NULL \n  AND  s.sigma > 0 \nORDER BY\n   d.time ASC",
          "refId": "A"
        }
      ],
      "title": "Z-Score: temperature",
      "transparent": true,
      "type": "timeseries"
    },
