      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "rowHeight": 0.8,
        "showHeader": true
      },
      "pluginVersion": "13.1.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "LDI"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"time\"AS \"Timestamp\",\r\nlog_id AS \"Log ID\", \r\neqp_id AS \"Machine\", \r\nstate AS \"State\", \r\nmo AS \"MO\", fpn AS \"FPN\", \r\nlayer_name AS \"Layer\", \r\n(board_no::TEXT || '/' || total_board::TEXT) AS \"Board\", \r\nfilmno AS \"Film\", \r\nresist AS \"Resist\", \r\nscale_mode AS \"Scale Mode\",  \r\nFLOOR(extract(epoch from \"time\") * 1000) AS \"UnixTime\" \r\nFROM public.ldi_data WHERE eqp_id IN (${Eqp:singlequote}) \r\nAND \"time\" >= to_timestamp(NULLIF('${clicked_time}', '')::numeric / 1000.0) \r\nAND \"time\" < to_timestamp(NULLIF('${clicked_time}', '')::numeric / 1000.0) + interval '1 minute'",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Machine Context",
      "transparent": true,
      "type": "table"
    },
