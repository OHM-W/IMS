      "targets": [
        {
          "datasource": {
            "uid": "LDI"
          },
          "format": "table",
          "rawSql": "WITH MaxPE AS (\nSELECT\n   eqp_id, GREATEST(ABS(COALESCE(pe_1,0)),ABS(COALESCE(pe_2,0)),ABS(COALESCE(pe_3,0)),ABS(COALESCE(pe_4,0)),ABS(COALESCE(pe_5,0)),ABS(COALESCE(pe_6,0))) AS max_error \nFROM\n   public.ldi_data \nWHERE\n   factory IN ($Factory) \n  AND  process IN ($process) \n  AND  $__timeFilter(time) \n  AND  pe_1 IS NOT NULL) \nSELECT\n   ROUND(AVG(max_error)::NUMERIC, 2) AS value \nFROM\n   MaxPE",
          "refId": "A"
        }
      ],
      "title": "Position Error Deviation (pe_1 ~ pe_6 µm)",
      "transparent": true,
      "type": "gauge"
    },
