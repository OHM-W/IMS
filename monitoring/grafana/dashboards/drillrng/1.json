      "panel-202": {
        "kind": "Panel",
        "spec": {
          "id": 202,
          "title": "Data Coverage by Message Type",
          "description": "Summary of ingested telemetry message volumes, active machines, and recorded time horizons",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "spec": {
                        "format": "table",
                        "rawSql": "/* NO_TIMEFILTER_INTENTIONAL: complete source capability inventory. */\nSELECT COALESCE(message_type,'NULL') AS \"Message Type\",COUNT(*) AS \"Records\",COUNT(DISTINCT equipment_id) AS \"Machines\",MIN(event_time) AS \"First Observed\",MAX(event_time) AS \"Last Observed\",CASE WHEN message_type='status' THEN 'Eligible for verified state mapping' WHEN message_type='alarm' THEN 'Historical alarm evidence' ELSE 'Recorded event evidence only' END AS \"Dashboard Use\"\nFROM public.machine_event\nGROUP BY message_type\nORDER BY \"Records\" DESC"
                      },
                      "labels": {
                        "grafana.app/export-label": "postgres-1",
                        "grafana.app/export-datasource-name": "grafana-postgresql-datasource"
