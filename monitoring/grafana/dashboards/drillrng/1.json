      "panel-201": {
        "kind": "Panel",
        "spec": {
          "id": 201,
          "title": "Top Recurring Errors",
          "description": "Ranking of most frequent machine alarm and error codes across the fleet for preventive maintenance",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT CASE WHEN event_code ~ '^[0-9]{4}$' THEN 'E'||event_code ELSE event_code END AS \"Error Code\", COUNT(*) AS \"Records\", COUNT(DISTINCT equipment_id) AS \"Machines\", MAX(event_time) AS \"Last Observed\", MAX(event_message) AS \"Example Evidence\"\nFROM public.machine_event\nWHERE $__timeFilter(event_time) AND message_type='alarm' AND level='E'\nGROUP BY event_code\nORDER BY \"Records\" DESC\nLIMIT 20"
                      },
                      "labels": {
                        "grafana.app/export-label": "postgres-1",
                        "grafana.app/export-datasource-name": "grafana-postgresql-datasource"
                      }
                    },
                    "refId": "A",
